# Copy this file to .env and REPLACE both placeholder values below.
# The app will refuse to start until you do.
#
# Find them in your Supabase dashboard under
# Project Settings > API Keys (older dashboards: Project Settings > API):
#   - URL: "Project URL", e.g. https://abcdefghijklm.supabase.co
#   - Key: the "anon" / "public" key (starts with eyJ), or the
#          "publishable" key (starts with sb_publishable_).
#          Never use the service_role or secret key here.
#
# Env values are baked in at build time, so after editing restart with:
#   npx expo start --clear
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
